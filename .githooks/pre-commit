#!/usr/bin/env bash
set -e

# Get staged Ruby files (excluding deleted files)
STAGED_RB_FILES=$(git diff --cached --name-only --diff-filter=d -- '*.rb')

if [ -z "$STAGED_RB_FILES" ]; then
  exit 0
fi

echo "Running rubocop on staged Ruby files..."

# Run rubocop with autocorrect on staged files
if bundle exec rubocop --autocorrect --force-exclusion $STAGED_RB_FILES; then
  # Check if autocorrect modified any files
  MODIFIED=$(git diff --name-only -- $STAGED_RB_FILES)
  if [ -n "$MODIFIED" ]; then
    echo ""
    echo "Rubocop auto-corrected the following files:"
    echo "$MODIFIED"
    echo ""
    echo "Review the changes, then stage and commit again."
    exit 1
  fi
else
  # rubocop found offenses it could not auto-correct
  echo ""
  echo "Rubocop found offenses that require manual fixes."
  exit 1
fi
