<div class="max-w-4xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Reports</h1>

  <% if @reports.empty? %>
    <p class="text-gray-500">No reports yet.</p>
  <% else %>
    <div class="space-y-3">
      <% @reports.each do |report| %>
        <div class="bg-white border border-gray-200 rounded-lg p-4 flex items-center justify-between">
          <div>
            <p class="font-medium text-gray-900"><%= report.filename %></p>
            <p class="text-sm text-gray-500">
              <%= report.created_at.strftime("%b %d, %Y %H:%M") %>
              <% if report.session %>
                · <%= link_to "Session ##{report.session.id}", session_path(report.session), class: "text-indigo-600 hover:underline" %>
              <% end %>
              <% if current_user.admin? && report.user %>
                · <%= report.user.name || report.user.email %>
              <% end %>
            </p>
          </div>
          <%= link_to "View", report_path(report), target: "_blank", rel: "noopener",
              class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
