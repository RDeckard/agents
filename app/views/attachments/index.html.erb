<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Files</h1>
    <div class="flex gap-2">
      <%= link_to "All", attachments_path, class: "px-3 py-1 rounded-full text-xs font-medium #{params[:kind].blank? ? 'bg-indigo-100 text-indigo-800' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
      <%= link_to "Outputs", attachments_path(kind: "agent_output"), class: "px-3 py-1 rounded-full text-xs font-medium #{params[:kind] == 'agent_output' ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
      <%= link_to "Uploads", attachments_path(kind: "uploaded_input"), class: "px-3 py-1 rounded-full text-xs font-medium #{params[:kind] == 'uploaded_input' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
    </div>
  </div>

  <% if @attachments.empty? %>
    <p class="text-gray-500">No files yet.</p>
  <% else %>
    <div class="space-y-3">
      <% @attachments.each do |attachment| %>
        <div class="bg-white border border-gray-200 rounded-lg p-4 flex items-center justify-between">
          <div>
            <div class="flex items-center gap-2">
              <p class="font-medium text-gray-900"><%= attachment.filename %></p>
              <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= attachment.kind == 'agent_output' ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800' %>">
                <%= attachment.kind == "agent_output" ? "output" : "upload" %>
              </span>
            </div>
            <p class="text-sm text-gray-500">
              <%= attachment.created_at.strftime("%b %d, %Y %H:%M") %>
              <% if attachment.byte_size %>
                · <%= number_to_human_size(attachment.byte_size) %>
              <% end %>
              <% if attachment.session %>
                · <%= link_to "Session ##{attachment.session.id}", session_path(attachment.session), class: "text-indigo-600 hover:underline" %>
              <% end %>
              <% if current_user.admin? && attachment.user %>
                · <%= attachment.user.name || attachment.user.email %>
              <% end %>
            </p>
          </div>
          <%= link_to "View", attachment_path(attachment), target: "_blank", rel: "noopener",
              class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
