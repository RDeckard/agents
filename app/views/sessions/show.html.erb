<div class="w-full max-w-4xl mx-auto" data-controller="session"
     data-session-url-value="<%= events_session_path(@session) %>"
     data-session-message-url-value="<%= message_session_path(@session) %>"
     data-session-attachments-url-value="<%= session_path(@session, format: :json) %>">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold"><%= @anthropic_session.title || "Session ##{@session.id}" %></h1>
      <p class="text-sm text-gray-500"><%= @anthropic_session.agent&.name rescue "Agent" %></p>
    </div>
    <div data-session-target="statusBadge" class="px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
      <%= @anthropic_session.status %>
    </div>
  </div>

  <% inputs = @session.attachments.inputs %>
  <% if inputs.any? %>
    <div class="mb-4 space-y-2">
      <p class="text-xs font-medium text-gray-400 uppercase tracking-wide">Uploaded files</p>
      <% inputs.each do |att| %>
        <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-200 rounded-md px-3 py-1.5 text-sm">
          <span class="text-blue-700"><%= att.filename %></span>
          <% if att.byte_size %>
            <span class="text-blue-400 text-xs"><%= number_to_human_size(att.byte_size) %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div id="events" data-session-target="events" class="space-y-3 mb-6 min-h-[200px] max-h-[60vh] overflow-y-auto bg-gray-50 rounded-lg p-4 border border-gray-200">
    <% if @history.any? %>
      <% @history.each do |event| %>
        <% type = event.type.to_s %>
        <% raw_content = (event[:content] rescue nil) %>
        <% text = Array(raw_content).filter_map { |b| b.respond_to?(:text) ? b.text : (b[:text] || b["text"] rescue nil) }.join %>
        <% if type == "user.message" && text.present? %>
          <div class="rounded-lg p-3 border bg-indigo-50 text-indigo-900 border-indigo-200"><%= text %></div>
        <% elsif type == "agent.message" && text.present? %>
          <div data-role="assistant-message" class="prose prose-sm max-w-none bg-white rounded-lg p-4 border border-gray-200"><%= render_markdown(text) %></div>
        <% elsif type == "agent.thinking" %>
          <details class="rounded-lg border bg-amber-50 text-amber-800 border-amber-200 text-xs italic">
            <summary class="p-3 cursor-pointer select-none list-none flex items-center gap-2">
              <svg class="w-3 h-3 transition-transform details-arrow shrink-0" viewBox="0 0 12 12"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>Thinking...
            </summary>
            <% if text.present? %>
              <div class="px-3 pb-3 pt-0 text-xs whitespace-pre-wrap break-all text-amber-700"><%= text %></div>
            <% end %>
          </details>
        <% elsif type == "agent.tool_use" %>
          <% tool_input = (event[:input] || event.input rescue nil) %>
          <details class="rounded-lg border bg-gray-100 text-gray-600 border-gray-200 text-xs font-mono">
            <summary class="p-3 cursor-pointer select-none list-none flex items-center gap-2">
              <svg class="w-3 h-3 transition-transform details-arrow shrink-0" viewBox="0 0 12 12"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>Using: <%= event[:name] || event.name %>
            </summary>
            <% if tool_input.present? %>
              <div class="px-3 pb-3 pt-0 text-xs whitespace-pre-wrap break-all text-gray-500"><%= tool_input.is_a?(String) ? tool_input : tool_input.to_json %></div>
            <% end %>
          </details>
        <% elsif type == "agent.tool_result" && text.present? %>
          <details class="rounded-lg border bg-gray-50 text-gray-500 border-gray-100 text-xs">
            <summary class="p-3 cursor-pointer select-none list-none flex items-center gap-2">
              <svg class="w-3 h-3 transition-transform details-arrow shrink-0" viewBox="0 0 12 12"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>Tool result
            </summary>
            <div class="px-3 pb-3 pt-0 text-xs whitespace-pre-wrap break-all text-gray-400"><%= text %></div>
          </details>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-gray-400 text-sm text-center py-8">Send a message to start.</p>
    <% end %>

    <% outputs = @session.attachments.outputs %>
    <% if outputs.any? %>
      <% outputs.order(created_at: :asc).each do |att| %>
        <div class="rounded-lg p-3 border bg-emerald-50 border-emerald-200 flex items-center justify-between">
          <span class="text-sm text-emerald-800"><%= att.filename %></span>
          <%= link_to "Open ↗", attachment_path(att), target: "_blank", rel: "noopener",
              class: "text-xs text-emerald-700 font-medium hover:text-emerald-900" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <form data-session-target="form" data-action="submit->session#send" class="space-y-2">
    <div data-session-target="filePreview" class="hidden flex flex-wrap gap-2"></div>
    <div class="flex gap-3">
      <label class="flex items-center justify-center w-10 h-10 rounded-md border border-gray-300 bg-white hover:bg-gray-50 cursor-pointer transition" title="Attach files">
        <input type="file" data-session-target="fileInput" data-action="change->session#filesChanged" multiple class="hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
        </svg>
      </label>
      <input type="text" data-session-target="input" placeholder="Type your message..."
             class="flex-1 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
             autofocus>
      <button type="submit" class="bg-indigo-600 text-white px-6 py-2 rounded-md hover:bg-indigo-700 transition font-medium">
        Send
      </button>
    </div>
  </form>
</div>
